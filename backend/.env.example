# ============================================================
# VOXIS BACKEND ENVIRONMENT
# ============================================================

APP_NAME=VOXIS
ENVIRONMENT=development

HOST=127.0.0.1
PORT=8000

# Frontend origins
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Upload limits
MAX_AUDIO_UPLOAD_MB=25

# Feature gates
WHISPER_ENABLED=false
LLM_ENABLED=false
SIGN_MODEL_ENABLED=false
TTS_ENABLED=false

# Optional future model/config paths
WHISPER_MODEL_SIZE=small
SIGN_MODEL_PATH=
