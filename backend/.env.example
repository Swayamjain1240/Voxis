# ============================================================
# VOXIS BACKEND ENVIRONMENT
# ============================================================

APP_NAME=VOXIS
ENVIRONMENT=development
DEBUG=false

HOST=127.0.0.1
PORT=8000

# Frontend origins
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ALLOWED_HOSTS=127.0.0.1,localhost,::1
RATE_LIMIT_PER_MINUTE=120
REQUEST_TIMEOUT_SECONDS=15

# Upload limits
MAX_AUDIO_UPLOAD_MB=25

# Feature gates
WHISPER_ENABLED=false
LLM_ENABLED=false
SIGN_MODEL_ENABLED=false
TTS_ENABLED=false

# Optional future model/config paths
WHISPER_MODEL_SIZE=small
WHISPER_MODEL_PATH=
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
SIGN_MODEL_PATH=
SIGN_CONFIDENCE_THRESHOLD=0.60
SIGN_MARGIN_THRESHOLD=0.05
