{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voxis.local/contracts/conversation-message.schema.json",
  "title": "VOXIS Conversation Message v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["message_id", "schema_version", "vocabulary_version", "sender", "source", "modality", "text", "glosses", "timestamp"],
  "properties": {
    "message_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_:-]+$"},
    "schema_version": {"const": "1.0.0"},
    "vocabulary_version": {"const": "1.0.0"},
    "sender": {"enum": ["user", "system", "rishi_pipeline", "swayam_pipeline"]},
    "source": {"enum": ["speech", "sign", "text", "system"]},
    "modality": {"enum": ["speech", "sign", "text", "avatar"]},
    "text": {"type": "string", "minLength": 1, "maxLength": 4000},
    "glosses": {"type": "array", "maxItems": 60, "items": {"enum": ["DOCTOR", "PATIENT", "MEDICINE", "SICK", "YESTERDAY", "BANK", "MONEY", "YES", "NO", "WHERE", "HELP", "PAIN"]}},
    "context": {"enum": ["hospital", "bank", "office", null]},
    "timestamp": {"type": "string", "format": "date-time"}
  }
}
