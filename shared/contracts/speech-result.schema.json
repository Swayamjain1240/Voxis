{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voxis.local/contracts/speech-result.schema.json",
  "title": "VOXIS Speech Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "schema_version", "vocabulary_version", "transcript", "language", "confidence", "glosses", "source", "timestamp"],
  "properties": {
    "type": {"const": "speech_result"},
    "schema_version": {"const": "1.0.0"},
    "vocabulary_version": {"const": "1.0.0"},
    "transcript": {"type": "string", "minLength": 1, "maxLength": 4000},
    "language": {"const": "en"},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "glosses": {"type": "array", "maxItems": 60, "items": {"enum": ["DOCTOR", "PATIENT", "MEDICINE", "SICK", "YESTERDAY", "BANK", "MONEY", "YES", "NO", "WHERE", "HELP", "PAIN"]}},
    "source": {"enum": ["microphone", "audio_file", "api"]},
    "timestamp": {"type": "string", "format": "date-time"}
  }
}
