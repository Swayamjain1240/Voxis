{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voxis.local/contracts/websocket-events.schema.json",
  "title": "VOXIS WebSocket Transport Status",
  "description": "Mode 1 does not accept or emit WebSocket events. This retained status contract prevents consumers from assuming the historical broadcast protocol is active.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "transport",
    "status",
    "mode",
    "schema_version"
  ],
  "properties": {
    "transport": {
      "const": "websocket"
    },
    "status": {
      "const": "disabled"
    },
    "mode": {
      "const": "mode-1"
    },
    "schema_version": {
      "const": "1.0.0"
    }
  }
}
