{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voxis.local/contracts/websocket-events.schema.json",
  "title": "VOXIS WebSocket Events",
  "description": "Shared event contract for real-time VOXIS communication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "schema_version",
    "timestamp"
  ],
  "properties": {
    "event": {
      "type": "string",
      "enum": [
        "speech.result",
        "sign.prediction",
        "conversation.message",
        "room.joined",
        "room.left",
        "pipeline.status",
        "error"
      ]
    },
    "schema_version": {
      "type": "string"
    },
    "room_id": {
      "type": ["string", "null"]
    },
    "sender_id": {
      "type": ["string", "null"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  }
}
