{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voxis.local/contracts/sign-prediction.schema.json",
  "title": "VOXIS Sign Prediction v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "schema_version", "vocabulary_version", "model_version", "prediction", "sequence_id", "timestamp"],
  "properties": {
    "type": {"const": "sign_prediction"},
    "schema_version": {"const": "1.0.0"},
    "vocabulary_version": {"const": "1.0.0"},
    "model_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "sequence_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_:-]+$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "prediction": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "gloss", "confidence", "stable"],
      "properties": {
        "label": {"type": "integer", "minimum": -1, "maximum": 11},
        "gloss": {"enum": ["DOCTOR", "PATIENT", "MEDICINE", "SICK", "YESTERDAY", "BANK", "MONEY", "YES", "NO", "WHERE", "HELP", "PAIN", "UNKNOWN"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "stable": {"type": "boolean"}
      },
      "if": {"properties": {"gloss": {"const": "UNKNOWN"}}},
      "then": {"properties": {"label": {"const": -1}, "stable": {"const": false}}},
      "else": {"properties": {"label": {"minimum": 0}}}
    }
  }
}
