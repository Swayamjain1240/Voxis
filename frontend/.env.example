VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Optional local/public MediaPipe Tasks Vision assets. These are not secrets.
# Leave blank to run the camera preview with an honest "not configured" state.
VITE_MEDIAPIPE_MODEL_URL=
VITE_MEDIAPIPE_WASM_ROOT=

# Optional local/public avatar asset:
# Put a rigged GLB at frontend/public/models/voxis-avatar.glb
# and set:
# VITE_AVATAR_MODEL_URL=/models/voxis-avatar.glb

VITE_AVATAR_MODEL_URL=
VITE_APP_NAME=VOXIS
